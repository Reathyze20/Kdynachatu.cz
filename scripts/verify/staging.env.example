# Staging verify harness credentials. Copy to scripts/verify/staging.env
# (gitignored) and fill in. Values live on the server / in your password manager.
STAGING_URL=https://staging.kdynachatu.cz
# nginx HTTP basic auth (/etc/nginx/.htpasswd-staging)
STAGING_BASIC_USER=rodina
STAGING_BASIC_PASS=
# Demo admin account from the staging seed (db:seed)
STAGING_DEMO_USER=demo-spravce
STAGING_DEMO_PASS=
# Optional: override Chrome/Chromium path
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
