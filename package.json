{
  "name": "cabin_reservation_app",
  "version": "1.11.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch src/backend/server.new.ts",
    "dev:frontend": "cd frontend-v2 && npm run dev",
    "preflight:deploy": "npm run prisma:generate && npx tsc --noEmit && npm run test:backend && npm --prefix frontend-v2 run test:run && npm --prefix frontend-v2 run build",
    "build": "cd frontend-v2 && npm run build",
    "build:install": "cd frontend-v2 && npm ci && npm run build",
    "start": "NODE_ENV=production node --import tsx src/backend/server.new.ts",
    "preview": "npm run build && npm run start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --import tsx --import ./src/testing/unitTestEnv.ts --test \"src/**/*.test.ts\"",
    "test:integration": "tsx src/scripts/runIntegrationTests.ts",
    "test:tenant-mutations": "tsx src/scripts/runTenantMutations.ts",
    "test:frontend": "npm --prefix frontend-v2 run test:run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "validate:ai": "tsx src/scripts/validateAiAssets.ts",
    "report:ai": "tsx src/scripts/reportAiGovernance.ts",
    "ideation": "tsx src/scripts/ideation.ts",
    "db:seed": "tsx src/scripts/seedStaging.ts",
    "db:migrate-json": "tsx src/scripts/migrateData.ts",
    "staging:seed-smoke": "tsx src/scripts/seedStagingSmoke.ts",
    "verify:staging": "node scripts/verify/staging.mjs",
    "create-learning-admin": "tsx src/scripts/createLearningAdmin.ts",
    "backup:db": "tsx src/scripts/backupManager.ts backup db",
    "backup:uploads": "tsx src/scripts/backupManager.ts backup uploads",
    "backup:all": "tsx src/scripts/backupManager.ts backup all",
    "backup:smoke": "tsx src/scripts/backupRestoreSmoke.ts",
    "migration:rehearsal": "tsx src/scripts/migrationRehearsalSmoke.ts",
    "migration:remove-admin": "tsx src/scripts/removeWeakAdmin.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:seed": "docker compose exec app npx tsx src/scripts/migrateData.ts"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "4.22.3",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^18.19.130",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.5",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  }
}
